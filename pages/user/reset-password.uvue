<template>
	<cl-page>
		<cl-topbar safe-area-top background-color="transparent">
			<template #left>
				<cl-icon name="arrow-left" @tap="router.back()"></cl-icon>
			</template>
			<template #title>
				<cl-text>{{ t("重置密码") }}</cl-text>
			</template>
		</cl-topbar>

		<!-- #ifdef APP -->
		<scroll-view class="container" style="flex: 1">
		<!-- #endif -->
		<view class="px-10">
			<!-- Logo -->
			<view class="flex flex-col items-center justify-center py-10">
				<cl-image
					src="/static/logo.png"
					mode="widthFix"
					:width="120"
					:height="120"
				></cl-image>
				<cl-text :pt="{ className: 'text-lg font-bold mt-2' }">{{ t("重置密码") }}</cl-text>
				<cl-text :pt="{ className: 'text-sm mt-1' }" color="info">{{ t("通过手机验证码重置密码") }}</cl-text>
			</view>

			<!-- 重置密码表单 -->
			<view class="flex flex-col">
				<!-- 手机号 -->
				<view class="mb-3 flex flex-row">
					<cl-input
						v-model="form.phone"
						prefix-icon="device-fill"
						:placeholder="t('请输入手机号')"
						:border="false"
						:pt="{
							className: parseClass([
								'!h-[90rpx] flex-1 !rounded-xl !px-4',
								[isDark, '!bg-surface-70', '!bg-white']
							]),
							prefixIcon: {
								className: 'mr-1'
							}
						}"
					></cl-input>
				</view>

				<!-- 验证码 -->
				<view class="mb-3 flex flex-row">
					<cl-input
						v-model="form.code"
						prefix-icon="shield-check-fill"
						:placeholder="t('请输入验证码')"
						:border="false"
						:pt="{
							className: parseClass([
								'!h-[90rpx] flex-1 !rounded-xl !px-4 mr-3',
								[isDark, '!bg-surface-70', '!bg-white']
							]),
							prefixIcon: {
								className: 'mr-1'
							}
						}"
					></cl-input>
					<sms-btn 
						:phone="form.phone" 
						type="reset"
						@success="onSmsSuccess"
						:ref="refs.set('smsBtn')"
					>
						<template #default="{ disabled, countdown, btnText }">
							<cl-button 
								:disabled="disabled"
								:pt="{ className: '!h-[90rpx] !rounded-xl !px-4' }"
								text
								@tap="openSmsBtn"
							>
								{{ btnText }}
							</cl-button>
						</template>
					</sms-btn>
				</view>

				<!-- 新密码 -->
				<view class="mb-3 flex flex-row">
					<cl-input
						v-model="form.password"
						:type="'password' as any"
						prefix-icon="lock-fill"
						:placeholder="t('请输入新密码')"
						:border="false"
						:pt="{
							className: parseClass([
								'!h-[90rpx] flex-1 !rounded-xl !px-4',
								[isDark, '!bg-surface-70', '!bg-white']
							]),
							prefixIcon: {
								className: 'mr-1'
							}
						}"
					></cl-input>
				</view>

				<!-- 确认密码 -->
				<view class="mb-5 flex flex-row">
					<cl-input
						v-model="confirmPassword"
						:type="'password' as any"
						prefix-icon="lock-fill"
						:placeholder="t('请确认新密码')"
						:border="false"
						:pt="{
							className: parseClass([
								'!h-[90rpx] flex-1 !rounded-xl !px-4',
								[isDark, '!bg-surface-70', '!bg-white']
							]),
							prefixIcon: {
								className: 'mr-1'
							}
						}"
					></cl-input>
				</view>

				<!-- 重置按钮 -->
				<cl-button
					:pt="{
						className: '!h-[90rpx] !rounded-xl'
					}"
					:loading="loading"
					:disabled="disabled"
					@tap="toReset"
				>
					{{ t("重置密码") }}
				</cl-button>
			</view>

			<!-- 登录链接 -->
			<view class="mt-6 flex flex-row items-center justify-center">
				<cl-text color="info" :pt="{ className: 'text-sm' }">{{ t("记起密码了？") }}</cl-text>
				<cl-text 
					:pt="{ className: 'text-sm ml-1' }"
					@tap="toLogin"
				>
					{{ t("立即登录") }}
				</cl-text>
			</view>
		</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
	</cl-page>
</template>

<script setup lang="ts">
import { isDark, parseClass, router, useRefs } from "@/cool";
import { t } from "@/locale";
import { computed, reactive, ref } from "vue";
import type { ResetPasswordForm } from "@/types";
import { useUi } from "@/uni_modules/cool-ui";
import SmsBtn from "@/components/sms-btn.uvue";
import { AuthService } from "@/cool/service/auth";

const ui = useUi();
const refs = useRefs();

// 表单
const form = reactive<ResetPasswordForm>({
	phone: "",
	code: "",
	password: ""
});

// 确认密码
const confirmPassword = ref("");

// 是否加载中
const loading = ref(false);

// 是否禁用
const disabled = computed(() => {
	return form.phone == "" || 
		   form.code == "" || 
		   form.password == "" || 
		   confirmPassword.value == "";
});

// 短信发送成功
function onSmsSuccess() {
}

// 打开短信验证码组件
function openSmsBtn() {
	refs.open('smsBtn');
}

// 重置密码
async function toReset() {
	// 验证手机号格式
	if (!/^(?:(?:\+|00)86)?1[3-9]\d{9}$/.test(form.phone)) {
		ui.showToast({
			message: t("请填写正确的手机号格式")
		});
		return;
	}

	// 验证密码长度
	if (form.password.length < 6) {
		ui.showToast({
			message: t("密码长度不能少于6位")
		});
		return;
	}

	// 验证两次密码是否一致
	if (form.password != confirmPassword.value) {
		ui.showToast({
			message: t("两次输入的密码不一致")
		});
		return;
	}

	loading.value = true;

	try {
		await AuthService.resetPassword(form);
		
		ui.showToast({
			message: t("密码重置成功")
		});

		// 跳转到登录页
		router.back();
	} catch (err: any) {
		let errMsg: string | null | undefined = null;
		
		// 安全地访问错误对象的 message 属性
		if (err != null && typeof err === "object") {
			try {
				// 尝试访问 message 属性
				const errObj = err as UTSJSONObject;
				const message = errObj["message"] as string | null;
				const errMsgProp = errObj["errMsg"] as string | null;
				
				if (message != null && message != "") {
					errMsg = message;
				} else if (errMsgProp != null && errMsgProp != "") {
					errMsg = errMsgProp;
				}
			} catch (e) {
				// 如果访问失败，忽略
			}
		}
		
		const errorMessage: string = (errMsg != null && errMsg != "" ? errMsg : t("重置失败")) as string;
		ui.showToast({
			message: errorMessage
		});
	}

	loading.value = false;
}

// 跳转到登录页
function toLogin() {
	router.back();
}
</script>

<style scoped>
.container {
	height: 100%;
}
</style>
