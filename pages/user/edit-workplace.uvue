<template>
	<cl-page>
		<cl-topbar safe-area-top :title="t('编辑工作单位')" background-color="transparent"> </cl-topbar>

		<view class="p-3">
			<cl-input
				v-model="content"
				autofocus
				:placeholder="t('请输入工作单位')"
				:border="false"
				:pt="{
					className: '!h-[80rpx]'
				}"
			>
				<template #append>
					<cl-text color="info" :pt="{ className: 'text-sm ml-2' }"
						>{{ content.length }}/50</cl-text
					>
				</template>
			</cl-input>

			<view class="p-3">
				<cl-text color="info" :pt="{ className: 'text-sm' }">{{
					t("请设置1-50个字符，不包括@<>/等无效字符")
				}}</cl-text>
			</view>
		</view>

		<cl-footer>
			<cl-button size="large" :disabled="content == ''" @tap="confirm">{{
				t("确认")
			}}</cl-button>
		</cl-footer>
	</cl-page>
</template>

<script setup lang="ts">
import { router, userInfo, useStore } from "@/cool";
import { t } from "@/locale";
import { useUi } from "@/uni_modules/cool-ui";
import { ref, onMounted } from "vue";

const ui = useUi();
const { user } = useStore();

// 输入框内容
const content = ref("");

// 确认按钮点击事件
async function confirm() {
	// 检查工作单位长度和特殊字符
	if (content.value.length < 1 || content.value.length > 50) {
		ui.showToast({
			message: t("工作单位长度需在1-50个字符之间")
		});
		return;
	}

	// 正则匹配 - 不允许特殊字符@<>/等
	const reg = /^[^@<>\/]*$/;
	if (!reg.test(content.value)) {
		ui.showToast({
			message: t("工作单位不能包含@<>/等特殊字符")
		});
		return;
	}

	// 更新用户工作单位
	await user.update({
		workplace: content.value
	});

	ui.showToast({
		message: t("工作单位更新成功")
	});

	setTimeout(() => {
		router.back();
	}, 1000);
}

// 页面加载时，设置输入框内容
onMounted(() => {
	content.value = userInfo.value?.workplace ?? "";
});
</script>
