<template>
	<cl-page>
		<cl-topbar
			fixed
			:height="100"
			:show-back="false"
			safe-area-top
			background-color="transparent"
		>
			<view class="flex flex-row items-center w-full flex-1 px-3">
				<view class="top-icon dark:!bg-surface-700" @tap="toSet">
					<cl-icon name="settings-line"></cl-icon>
				</view>

				<view class="top-icon dark:!bg-surface-700">
					<cl-icon name="notification-4-line"></cl-icon>
				</view>
			</view>
		</cl-topbar>

		<view class="p-3">
			<view class="flex flex-col justify-center items-center pt-6 pb-3">
				<view class="relative overflow-visible" @tap="toEdit">
					<cl-avatar
						:src="getUserAvatar()"
						:size="150"
						:pt="{ className: '!rounded-3xl', icon: { size: 60 } }"
					>
					</cl-avatar>

					<view
						class="flex flex-col justify-center items-center absolute bottom-0 right-[-6rpx] bg-black rounded-full p-1"
						v-if="user.isNull() == false"
					>
						<cl-icon name="edit-line" color="white" :size="24"></cl-icon>
					</view>
				</view>

				<view class="flex-1 flex flex-col justify-center items-center w-full" @tap="toEdit">
					<cl-text :pt="{ className: '!text-xl mt-5 mb-1 font-bold' }">{{
						getUserNickname() != "" ? getUserNickname() : t("未登录")
					}}</cl-text>
					<cl-text color="info" v-if="user.isNull() == false">{{ getUserPhone() }}</cl-text>
				</view>
			</view>

			<cl-row
				:pt="{
					className: 'pt-3 pb-6'
				}"
			>
				<cl-col :span="6">
					<view class="flex flex-col items-center justify-center">
						<cl-rolling-number
							:pt="{ className: '!text-xl' }"
							:value="dashboardData != null && dashboardData.stats != null && dashboardData.stats.tasks != null && dashboardData.stats.tasks.total != null ? dashboardData.stats.tasks.total : 0"
						></cl-rolling-number>
						<cl-text :pt="{ className: 'mt-1 !text-xs' }" color="info">{{
							t("任务数")
						}}</cl-text>
					</view>
				</cl-col>

				<cl-col :span="6">
					<view class="flex flex-col items-center justify-center">
						<cl-rolling-number
							:pt="{ className: '!text-xl' }"
							:value="dashboardData != null && dashboardData.stats != null && dashboardData.stats.checkins != null && dashboardData.stats.checkins.consecutive_days != null ? dashboardData.stats.checkins.consecutive_days : 0"
						></cl-rolling-number>
						<cl-text :pt="{ className: 'mt-1 !text-xs' }" color="info">{{
							t("连续天数")
						}}</cl-text>
					</view>
				</cl-col>

				<cl-col :span="6">
					<view class="flex flex-col items-center justify-center" @tap="toIntegralHistory">
						<cl-rolling-number
							:pt="{ className: '!text-xl' }"
							:value="getUserIntegral()"
						></cl-rolling-number>
						<cl-text :pt="{ className: 'mt-1 !text-xs' }" color="info">{{
							t("积分")
						}}</cl-text>
					</view>
				</cl-col>

				<cl-col :span="6">
					<view class="flex flex-col items-center justify-center">
						<cl-text :pt="{ className: '!text-xl' }">{{getUserLevelName()}}</cl-text>
						<cl-text :pt="{ className: 'mt-1 !text-xs' }" color="info">{{
							t("等级")
						}}</cl-text>
					</view>
				</cl-col>
			</cl-row>

			<cl-row :gutter="20" :pt="{ className: 'mb-3' }">
				<cl-col :span="12">
					<view class="bg-white dark:!bg-surface-800 p-4 rounded-2xl flex flex-row">
						<view class="flex flex-col mr-auto">
							<cl-text
								ellipsis
								:pt="{
									className: '!w-[180rpx]'
								}"
								>{{ t("打卡提醒") }}</cl-text
							>
							<cl-text :pt="{ className: '!text-xs mt-1' }" color="info">{{
								t("已开启")
							}}</cl-text>
						</view>

						<cl-switch v-model="reminderEnabled"></cl-switch>
					</view>
				</cl-col>

				<cl-col :span="12">
					<view class="bg-white dark:!bg-surface-800 p-4 rounded-2xl flex flex-row">
						<view class="flex flex-col mr-auto">
							<cl-text
								ellipsis
								:pt="{
									className: '!w-[180rpx]'
								}"
								>{{ t("消息通知") }}</cl-text
							>
							<cl-text :pt="{ className: '!text-xs mt-1' }" color="info">{{
								t("已开启")
							}}</cl-text>
						</view>

						<cl-switch v-model="notificationEnabled"></cl-switch>
					</view>
				</cl-col>
			</cl-row>

			<view class="bg-white dark:!bg-surface-800 py-5 rounded-2xl mb-3 h-[160rpx]">
				<cl-row :pt="{ className: 'overflow-visible' }">
					<cl-col :span="6">
						<view class="flex flex-col justify-center items-center px-2" @tap="toMyStudents">
							<cl-icon name="user-line" :size="46"></cl-icon>
							<cl-text
								:pt="{ className: '!text-xs mt-2 text-center' }"
								color="info"
								>{{ t("我的学员") }}</cl-text
							>
						</view>
					</cl-col>

					<cl-col :span="6">
						<view class="flex flex-col justify-center items-center px-2" @tap="toMyMentor">
							<cl-icon name="user-star-line" :size="46"></cl-icon>
							<cl-text
								:pt="{ className: '!text-xs mt-2 text-center' }"
								color="info"
								>{{ t("我的导师") }}</cl-text
							>
						</view>
					</cl-col>

					<cl-col :span="6">
						<view
							class="flex flex-col justify-center items-center relative overflow-visible px-2"
							@tap="toMyActivities"
						>
							<cl-icon name="calendar-event-line" :size="46"></cl-icon>
							<cl-text
								:pt="{ className: '!text-xs mt-2 text-center' }"
								color="info"
								>{{ t("我的活动") }}</cl-text
							>

							<cl-badge
								v-if="dashboardData != null && dashboardData.stats != null && dashboardData.stats.activities != null && dashboardData.stats.activities.attended != null && dashboardData.stats.activities.attended > 0"
								type="primary"
								:value="dashboardData != null && dashboardData.stats != null && dashboardData.stats.activities != null && dashboardData.stats.activities.attended != null ? dashboardData.stats.activities.attended : 0"
								position
								:pt="{ className: '!right-6' }"
							></cl-badge>
						</view>
					</cl-col>

					<cl-col :span="6">
						<view class="flex flex-col justify-center items-center px-2" @tap="toIntegralPurchase">
							<cl-icon name="trophy-line" :size="46"></cl-icon>
							<cl-text
								:pt="{ className: '!text-xs mt-2 text-center' }"
								color="info"
								>{{ t("咨询服务") }}</cl-text
							>
						</view>
					</cl-col>
				</cl-row>
			</view>

			<cl-list :pt="{ className: 'mb-3' }">
				<cl-list-item
					:label="t('个人简介')"
					icon="pie-chart-line"
					arrow
					hoverable
					@tap="toDescription"
				>
				</cl-list-item>
				<cl-list-item
					:label="t('成就徽章')"
					icon="trophy-line"
					arrow
					hoverable
					@tap="toBadges"
				>
				</cl-list-item>
				<cl-list-item
					:label="t('邀请好友')"
					icon="share-line"
					arrow
					hoverable
					@tap="toInvite"
				>
				</cl-list-item>
				<cl-list-item
					:label="t('帮助反馈')"
					icon="question-line"
					arrow
					hoverable
					@tap="toHelp"
				>
				</cl-list-item>
			</cl-list>

			<cl-list>
				<cl-list-item :label="t('设置')" icon="settings-line" arrow hoverable @tap="toSet">
				</cl-list-item>
			</cl-list>
		</view>

		<!-- 自定义底部导航栏 -->
		<custom-tabbar></custom-tabbar>
	</cl-page>
</template>

<script setup lang="ts">
import { router, userInfo, useStore } from "@/cool";
import { t } from "@/locale";
import { useUi } from "@/uni_modules/cool-ui";
import type { DashboardData } from "@/types/habit";
import type { UserInfo } from "@/types";
import { ref, onMounted, computed } from "vue";
import CustomTabbar from "@/components/tabbar.uvue";

const { user, dashboard } = useStore();
const ui = useUi();

// 数据
const reminderEnabled = ref(true);
const notificationEnabled = ref(true);

// 使用store中的数据
const dashboardData = computed<DashboardData | null>(() => dashboard.dashboardData.value);

// 创建本地的 userInfo computed，避免模板中的类型问题
const localUserInfo = computed(() => userInfo.value);

// 辅助函数：安全获取用户属性
function getUserAvatar(): string {
	const info = userInfo.value;
	return info != null && info.avatar != null ? info.avatar : "";
}

function getUserNickname(): string {
	const info = userInfo.value;
	return info != null && info.nickname != null ? info.nickname : "";
}

function getUserPhone(): string {
	const info = userInfo.value;
	return info != null && info.phone != null ? info.phone : "";
}

function getUserLevelName(): string {
	const info = userInfo.value;
	return info != null && info.level_name != null ? info.level_name : "";
}

function getUserIntegral(): number {
	const info = userInfo.value;
	return info != null && info.integral != null ? info.integral : 0;
}

// 页面跳转方法
function toSet() {
	router.to("/pages/set/index");
}

function toEdit() {
	router.to("/pages/user/edit");
}

// 辅助函数：安全获取用户是否为导师
function getUserIsMentor(userInfoValue: UserInfo | null): boolean {
	return userInfoValue != null && userInfoValue.is_mentor === true;
}

function toMyStudents() {
	// 检查是否为导师
	const info = userInfo.value;
	if (!getUserIsMentor(info)) {
		router.to("/pages/mentor/apply");
		return;
	}
	router.to("/pages/mentor/my-students");
}

function toMyMentor() {
	router.to("/pages/mentor/my");
}

function toMyActivities() {
	router.to("/pages/activity/my");
}

function toIntegralHistory() {
	router.to("/pages/user/integral");
}

function toIntegralPurchase() {
	router.to("/pages/user/integral-purchase");
}

function toDescription() {
	router.to("/pages/user/edit-description");
}

function toBadges() {
	ui.showToast({ message: '成就徽章功能正在测试' });
	// router.to("/pages/user/badges");
}

function toInvite() {
	ui.showToast({ message: '邀请好友功能正在测试' });
	// router.to("/pages/user/invite");
}

function toHelp() {
	ui.showToast({ message: '帮助反馈功能正在测试' });
	// router.to("/pages/user/help");
}

// 加载数据
async function loadDashboardData() {
	try {
		await dashboard.getDashboard();
	} catch (error) {
		console.error('加载数据失败:', error);
	}
}

onMounted(() => {
	user.get();
	loadDashboardData();
});
</script>

<style lang="scss" scoped>
.top-icon {
	@apply flex items-center justify-center rounded-lg bg-white mr-3 p-2;
}
</style>
