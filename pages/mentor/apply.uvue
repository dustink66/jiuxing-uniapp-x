<template>
	<cl-page>
		<!-- #ifdef APP -->
		<scroll-view class="container" style="flex: 1">
		<!-- #endif -->
		<view class="px-4">
			<!-- 已经是导师的提示 -->
			<view v-if="isAlreadyMentor" class="bg-gradient-to-r from-success-500 to-success-600 rounded-xl mt-4 p-4 mb-4 text-white">
				<view class="text-center">
					<cl-icon name="check-circle-fill" :size="48" color="white"></cl-icon>
					<cl-text :pt="{ className: '!text-lg font-bold mt-2' }">{{ t("您已经是导师了") }}</cl-text>
					<cl-text :pt="{ className: '!text-sm mt-1' }">
						{{ t("恭喜您已经成为导师，可以开始帮助其他用户养成良好的生活习惯。") }}
					</cl-text>
				</view>
			</view>

			<!-- 申请状态 -->
			<view v-else-if="mentorStatus !== 0" class="bg-white dark:!bg-surface-800 rounded-xl mt-4 p-4 mb-4">
				<cl-text :pt="{ className: '!text-lg font-bold mb-3' }">{{ t("申请状态") }}</cl-text>
				<view class="text-center">
					<cl-icon 
						:name="getStatusIcon()" 
						:size="48" 
						:color="getStatusColor()"
					></cl-icon>
					<cl-text :pt="{ className: 'mt-2' }" :color="getStatusColor()">{{ getStatusText() }}</cl-text>
				</view>
			</view>

			<!-- 申请表单 -->
			<view v-if="!isAlreadyMentor && mentorStatus === 0" class="flex flex-col mt-4">

				<!-- 学员申请积分要求 -->
				<view class="mb-3">
					<cl-text :pt="{ className: 'text-sm mb-2' }" color="info">{{ t("学员申请积分要求") }} *</cl-text>
					<cl-input-number
						v-model="form.student_required_integral"
						:min="0"
						:max="10000"
						:placeholder="t('请输入积分要求')"
						:border="false"
						:pt="{
							className: parseClass([
								'!rounded-xl !p-4',
								[isDark, '!bg-surface-70', '!bg-white']
							])
						}"
					></cl-input-number>
				</view>

				<!-- 导师介绍 -->
				<view class="mb-3">
					<cl-text :pt="{ className: 'text-sm mb-2' }" color="info">{{ t("导师介绍") }} *</cl-text>
					<cl-textarea
						v-model="form.description"
						:placeholder="t('请输入导师介绍，分享您的经验和心得...')"
						:maxlength="1000"
						:pt="{
							className: parseClass([
								'!min-h-24 !rounded-xl !px-4',
								[isDark, '!bg-surface-70', '!bg-white']
							])
						}"
					></cl-textarea>
				</view>

				<!-- 推荐人手机号 -->
				<view class="mb-5">
					<cl-text :pt="{ className: 'text-sm mb-2' }" color="info">{{ t("推荐人手机号") }} *</cl-text>
					<cl-input
						v-model="form.referrer_phone"
						prefix-icon="device-fill"
						:placeholder="t('请输入推荐人手机号')"
						:border="false"
						:pt="{
							className: parseClass([
								'!h-[90rpx] !rounded-xl !px-4',
								[isDark, '!bg-surface-70', '!bg-white']
							]),
							prefixIcon: {
								className: 'mr-1'
							}
						}"
					></cl-input>
				</view>

				<!-- 申请按钮 -->
				<cl-button
					:pt="{
						className: '!h-[90rpx] !rounded-xl'
					}"
					:loading="loading"
					:disabled="disabled"
					@tap="applyMentor"
				>
					{{ t("申请成为导师") }}
				</cl-button>
			</view>
		</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
	</cl-page>
</template>

<script lang="ts" setup>
import { router, isDark, parseClass, useStore } from "@/cool";
import { t } from "@/locale";
import { ref, onMounted, computed, reactive } from "vue";
import { useUi } from "@/uni_modules/cool-ui";
import { MentorService } from "@/cool/service/mentor";
import type { MentorApplyForm } from "@/types/habit";
import type { UserInfo } from "@/types";

const ui = useUi();
const { user } = useStore();

// 数据
const loading = ref(false);
const mentorStatus = ref(0); // 0-未申请, 1-审核中, 2-已通过, 3-已拒绝

// 表单
const form = reactive<MentorApplyForm>({
	student_required_integral: 500,
	description: "",
	referrer_phone: ""
});

// 计算属性
const disabled = computed(() => {
	return form.student_required_integral < 0 || 
		   form.student_required_integral > 10000 ||
		   form.description === "" || 
		   form.referrer_phone === "";
});

// 判断用户是否已经是导师
const isAlreadyMentor = computed(() => {
	return user.info.value?.is_mentor === true;
});

// 方法
function getStatusIcon(): string {
	switch (mentorStatus.value) {
		case 1: return 'time-line';
		case 2: return 'check-line';
		case 3: return 'close-line';
		default: return 'user-line';
	}
}

function getStatusColor(): string {
	switch (mentorStatus.value) {
		case 1: return 'warning';
		case 2: return 'success';
		case 3: return 'error';
		default: return 'surface-400';
	}
}

function getStatusText(): string {
	switch (mentorStatus.value) {
		case 1: return t('审核中');
		case 2: return t('已通过');
		case 3: return t('已拒绝');
		default: return t('未申请');
	}
}


async function applyMentor() {
	// 检查用户是否已登录
	if (user.isNull()) {
		ui.showToast({
			message: t("请先登录")
		});
		router.login();
		return;
	}

	// 验证手机号格式
	if (!/^(?:(?:\+|00)86)?1[3-9]\d{9}$/.test(form.referrer_phone)) {
		ui.showToast({
			message: t("请填写正确的推荐人手机号格式")
		});
		return;
	}


	// 验证介绍长度
	if (form.description.length > 1000) {
		ui.showToast({
			message: t("导师介绍不能超过1000个字符")
		});
		return;
	}

	try {
		loading.value = true;
		await MentorService.apply(form);
		ui.showToast({
			message: t("申请成功，已自动审核通过")
		});
		mentorStatus.value = 2;
	} catch (error: any) {
		const errorMsg = error != null && error.message != null && error.message != "" ? error.message : t("申请失败");
		const errorMessage: string = errorMsg != null ? errorMsg : t("申请失败");
		ui.showToast({
			message: errorMessage
		});
	} finally {
		loading.value = false;
	}
}

// 加载数据
async function loadData() {
	try {
		// 检查用户是否已登录
		if (user.isNull()) {
			ui.showToast({
				message: t("请先登录")
			});
			router.login();
			return;
		}
		
		// 如果用户已经是导师，不需要加载申请状态
		if (user.info.value?.is_mentor === true) {
			return;
		}

		// 由于mentor_status字段已删除，现在只通过is_mentor判断
		// 如果用户不是导师，默认为未申请状态
		mentorStatus.value = 0;
	} catch (error) {
		console.error('加载数据失败:', error);
		ui.showToast({
			message: t("加载数据失败")
		});
	}
}

onMounted(() => {
	loadData();
});
</script>

<style lang="scss" scoped>
.container {
	height: 100%;
}
</style>
