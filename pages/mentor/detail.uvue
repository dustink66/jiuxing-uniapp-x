<template>
	<cl-page>
		<!-- #ifdef APP -->
		<scroll-view class="container" style="flex: 1">
		<!-- #endif -->
		<view class="p-3">
			<!-- 导师信息 -->
			<view v-if="ment != null" class="bg-white dark:!bg-surface-800 rounded-xl p-4 mb-4">
				<!-- 导师基本信息 -->
				<view class="flex flex-row items-start mb-3">
					<cl-avatar :src="getMentorAvatar()" :size="80" :pt="{ className: '!rounded-full' }"></cl-avatar>
					<view class="ml-3 flex-1">
						<view class="flex flex-row items-center mb-1">
							<cl-text :pt="{ className: '!text-lg font-bold' }">{{ getMentorName() }}</cl-text>
							<cl-text color="primary" :pt="{ className: '!text-sm ml-2' }">{{ getMentorLevelName() }}</cl-text>
						</view>
						<view class="flex flex-row items-center gap-3">
							<view v-if="getMentorGender() != null" class="flex flex-row items-center mr-2">
								<cl-icon name="user-line" :size="20" color="surface-400" :pt="{ className: 'dark:!text-surface-400' }"></cl-icon>
								<cl-text color="surface-400" :pt="{ className: '!text-xs ml-1 dark:!text-surface-400' }">
									{{ getMentorGender() === 1 ? '男' : getMentorGender() === 2 ? '女' : '未知' }}
								</cl-text>
							</view>
							<view v-if="getMentorAge() != null" class="flex flex-row items-center  mr-2">
								<cl-icon name="calendar-line" :size="20" color="surface-400" :pt="{ className: 'dark:!text-surface-400' }"></cl-icon>
								<cl-text color="surface-400" :pt="{ className: '!text-xs ml-1 dark:!text-surface-400' }">{{ getMentorAge() }}岁</cl-text>
							</view>
							<view v-if="getMentorCity() != ''" class="flex flex-row items-center mr-2">
								<cl-icon name="map-pin-line" :size="20" color="surface-400" :pt="{ className: 'dark:!text-surface-400' }"></cl-icon>
								<cl-text color="surface-400" :pt="{ className: '!text-xs ml-1 dark:!text-surface-400' }">{{ getMentorCity() }}</cl-text>
							</view>
							<view v-if="getMentorWorkplace() != ''" class="flex flex-row items-center">
								<cl-icon name="briefcase-line" :size="20" color="surface-400" :pt="{ className: 'dark:!text-surface-400' }"></cl-icon>
								<cl-text color="surface-400" :pt="{ className: '!text-xs ml-1 dark:!text-surface-400' }">{{ getMentorWorkplace() }}</cl-text>
							</view>
						</view>
					</view>
				</view>
				
				<!-- 导师数据统计 -->
				<view class="flex flex-row items-center justify-between">
					<view class="flex flex-row items-center">
						<cl-icon name="star-line" :size="24" color="primary"></cl-icon>
						<cl-text color="primary" :pt="{ className: '!text-sm ml-1' }">
							入学门槛 {{ getMentorStudentRequiredIntegral() }}积分
						</cl-text>
					</view>
					<view class="flex flex-row items-center">
						<cl-icon name="user-heart-line" :size="24" color="success"></cl-icon>
						<cl-text color="success" :pt="{ className: '!text-sm ml-1' }">
							学员情况 {{ getMentorActiveStudentsCount() }} / {{ getMentorMaxStudents() }}
						</cl-text>
					</view>
				</view>
			</view>

			<!-- 操作按钮 -->
			<view class="mb-4">
				<cl-button 
					type="primary" 
					size="large" 
					:disabled="canBind != true"
					@tap="bindMentor"
				>
					{{ getButtonText() }}
				</cl-button>
			</view>

			<!-- 导师介绍 -->
			<view v-if="ment != null" class="bg-white dark:!bg-surface-800 rounded-xl p-4">
				<cl-text :pt="{ className: '!text-lg font-bold mb-3' }">导师介绍</cl-text>
				<cl-text color="surface-400" :pt="{ className: '!text-sm dark:!text-surface-400' }">
					{{ getMentorDescription() }}
				</cl-text>
			</view>
		</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
	</cl-page>
</template>

<script lang="ts" setup>
import { router, parse, useStore } from "@/cool";
import { ref, onMounted, computed } from "vue";
import { useUi } from "@/uni_modules/cool-ui";
import type { MentorInfo } from "@/types/habit";
import type { UserInfo } from "@/types";
import type { Response } from "@/cool/service";

const ui = useUi();
const { mentor: mentorStore, user: userStore } = useStore();
const props = defineProps(["id"])

// 数据
const mentor = ref<MentorInfo | null>(null);
const mentorId = ref<number>(0);

// 使用 computed 避免 Smart cast 问题
const ment = computed<MentorInfo | null>(() => {
	return mentor.value;
});

// 计算属性
const canBind = computed(() => {
	const m = mentor.value;
	const u = userStore.info.value;
	if (m == null || u == null) return false;
	const mentorInfo = m as MentorInfo;
	return u.integral >= mentorInfo.student_required_integral;
});

// 辅助函数：安全获取导师属性
function getMentorName(): string {
	const m = ment.value;
	if (m == null) return '';
	const mentorInfo = m as MentorInfo;
	return mentorInfo?.name ?? '';
}

function getMentorLevelName(): string {
	const m = ment.value;
	if (m == null) return '';
	const mentorInfo = m as MentorInfo;
	return mentorInfo?.level_name ?? '';
}

function getMentorAvatar(): string {
	const m = ment.value;
	if (m == null) return '';
	const mentorInfo = m as MentorInfo;
	return mentorInfo?.avatar ?? '';
}

function getMentorGender(): number | null {
	const m = ment.value;
	if (m == null) return null;
	const mentorInfo = m as MentorInfo;
	return mentorInfo?.gender ?? null;
}

function getMentorAge(): number | null {
	const m = ment.value;
	if (m == null) return null;
	const mentorInfo = m as MentorInfo;
	return mentorInfo?.age ?? null;
}

function getMentorCity(): string {
	const m = ment.value;
	if (m == null) return '';
	const mentorInfo = m as MentorInfo;
	return mentorInfo?.city ?? '';
}

function getMentorWorkplace(): string {
	const m = ment.value;
	if (m == null) return '';
	const mentorInfo = m as MentorInfo;
	return mentorInfo?.workplace ?? '';
}

function getMentorStudentRequiredIntegral(): number {
	const m = ment.value;
	if (m == null) return 0;
	const mentorInfo = m as MentorInfo;
	return mentorInfo?.student_required_integral ?? 0;
}

function getMentorActiveStudentsCount(): number {
	const m = ment.value;
	if (m == null) return 0;
	const mentorInfo = m as MentorInfo;
	return mentorInfo?.active_students_count ?? 0;
}

function getMentorMaxStudents(): number {
	const m = ment.value;
	if (m == null) return 0;
	const mentorInfo = m as MentorInfo;
	return mentorInfo?.max_students ?? 0;
}

function getMentorDescription(): string {
	const m = ment.value;
	if (m == null) return '暂无介绍';
	const mentorInfo = m as MentorInfo;
	const description = mentorInfo?.description;
	return description != null && description != "" ? description : '暂无介绍';
}

// 方法
function goBack() {
	router.back();
}

function getButtonText(): string {
	const m = mentor.value;
	const u = userStore.info.value;
	if (m == null || u == null) return '加载中...';
	const mentorInfo = m as MentorInfo;
	if (u.integral < mentorInfo.student_required_integral) {
		return `需要${mentorInfo.student_required_integral}积分`;
	}
	return '申请成为学员';
}

async function bindMentor() {
	if (canBind.value != true) {
		ui.showToast({
			message: '积分不足，无法申请'
		});
		return;
	}

	try {
		await mentorStore.bindMentor(mentorId.value);
		ui.showToast({
			message: '申请成功，等待导师审核'
		});
		setTimeout(() => {
			router.to("/pages/mentor/my");
		}, 1500);
	} catch (error: any) {
		let errorMessage = '申请失败';
		
		if (error != null) {
			// 在 Android 平台上，错误对象可能是 HolderUTSError，需要特殊处理
			// #ifdef APP-ANDROID
			// 尝试使用 JSON 转换来访问属性
			try {
				// 使用 JSON 转换来避免类型转换问题
				const errorStr = JSON.stringify(error);
				const errorParsed = JSON.parse(errorStr);
				// 将解析后的对象转换为 UTSJSONObject 以使用索引访问
				const errorObj = errorParsed as UTSJSONObject;
				const msg = errorObj["message"] as string | null;
				if (msg != null && msg != "") {
					errorMessage = msg;
				}
			} catch (e) {
				// 如果 JSON 转换失败，尝试直接转换为 Response 类型
				try {
					const errorResponse = error as Response;
					if (errorResponse.message != null && errorResponse.message != "") {
						errorMessage = errorResponse.message;
					}
				} catch (e2) {
					// 如果还是失败，使用默认错误信息
					console.error("无法解析错误信息:", e2);
				}
			}
			// #endif
			
			// #ifndef APP-ANDROID
			// 在其他平台上，直接访问 message 属性
			if (error.message != null && error.message != "") {
				errorMessage = error.message;
			}
			// #endif
		}
		
		ui.showToast({
			message: errorMessage
		});
	}
}

// 加载数据
async function loadData() {
	try {
		if (props.id == null) {
			ui.showToast({
				message: '导师ID不能为空'
			});
			return;
		}
		// 使用 store 的 getMentorDetail 方法获取数据
		const mentorData = await mentorStore.getMentorDetail(props.id as string);
		if (mentorData != null) {
			mentor.value = mentorData;
			mentorId.value = mentorData.id;
		}

		// 确保用户信息已加载（如果 store 中没有，则从服务端获取）
		if (userStore.info.value == null) {
			await userStore.get();
		}

	} catch (error) {
		console.error('加载数据失败:', error);
		ui.showToast({
			message: '加载数据失败'
		});
	}
}

onMounted(() => {
	loadData();
});
</script>

<style lang="scss" scoped>
.container {
	height: 100%;
}
</style>
