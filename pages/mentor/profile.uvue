<template>
	<cl-page>

		<!-- #ifdef APP -->
		<scroll-view class="container" style="flex: 1">
		<!-- #endif -->
		<view class="p-3">
			<!-- 导师资料表单 -->
			<view class="bg-white dark:!bg-surface-800 rounded-xl p-4 mb-4">
				<cl-text :pt="{ className: '!text-lg font-bold mb-4' }">{{ t("导师资料设置") }}</cl-text>
				
				<!-- 导师简介 -->
				<view class="mb-4">
					<cl-text :pt="{ className: 'text-sm mb-2' }" color="info">{{ t("导师简介") }} *</cl-text>
					<cl-textarea
						v-model="form.description"
						:placeholder="t('请输入导师简介，分享您的经验和心得...')"
						:maxlength="1000"
						:pt="{
							className: parseClass([
								'!min-h-24 !rounded-xl !px-4',
								[isDark, '!bg-surface-70', '!bg-white']
							])
						}"
					></cl-textarea>
					<cl-text color="info" :pt="{ className: '!text-xs mt-1' }">
						{{ form.description.length }}/1000
					</cl-text>
				</view>

				<!-- 学员申请积分要求 -->
				<view class="mb-4">
					<cl-text :pt="{ className: 'text-sm mb-2' }" color="info">{{ t("学员申请积分要求") }} *</cl-text>
					<cl-input-number
						v-model="form.student_required_integral"
						:min="0"
						:max="10000"
						:placeholder="t('请输入积分要求')"
						:border="false"
						:pt="{
							className: parseClass([
								'!rounded-xl !p-4',
								[isDark, '!bg-surface-70', '!bg-white']
							])
						}"
					></cl-input-number>
					<cl-text color="info" :pt="{ className: '!text-xs mt-1' }">
						{{ t("学员申请绑定您时需要达到的积分要求") }}
					</cl-text>
				</view>

				<!-- 最大招收学员数量 -->
				<view class="mb-4">
					<cl-text :pt="{ className: 'text-sm mb-2' }" color="info">{{ t("最大招收学员数量") }} *</cl-text>
					<cl-input-number
						v-model="form.max_students"
						:min="1"
						:max="100"
						:placeholder="t('请输入最大招收学员数量')"
						:border="false"
						:pt="{
							className: parseClass([
								'!rounded-xl !p-4',
								[isDark, '!bg-surface-70', '!bg-white']
							])
						}"
					></cl-input-number>
					<cl-text color="info" :pt="{ className: '!text-xs mt-1' }">
						{{ t("您最多可以招收的学员数量") }}
					</cl-text>
				</view>
			</view>

			<!-- 保存按钮 -->
			<cl-button
				:disabled="disabled"
				:loading="loading"
				:pt="{ className: '!h-[90rpx] !rounded-xl' }"
				@tap="saveProfile"
			>
				{{ t("保存资料") }}
			</cl-button>
		</view>
		<!-- #ifdef APP -->
		</scroll-view>
		<!-- #endif -->
	</cl-page>
</template>

<script lang="ts" setup>
import { router, isDark, parseClass, parse } from "@/cool";
import { t } from "@/locale";
import { ref, onMounted, computed, reactive } from "vue";
import { useUi } from "@/uni_modules/cool-ui";
import { MentorService } from "@/cool/service/mentor";
import type { MentorProfileForm, MentorInfo } from "@/types/habit";

const ui = useUi();

// 数据
const loading = ref(false);

// 表单
const form = reactive<MentorProfileForm>({
	description: "",
	student_required_integral: 500,
	max_students: 10
});

// 计算属性
const disabled = computed(() => {
	return form.description.trim() === "" || 
		   form.student_required_integral < 0 || 
		   form.student_required_integral > 10000 ||
		   form.max_students < 1 || 
		   form.max_students > 100;
});

// 辅助函数：安全获取导师资料属性
function getProfileDescription(profile: any): string {
	// #ifdef APP-ANDROID
	// 在 Android 平台上，profile 可能是 UTSJSONObject，使用索引访问
	try {
		const profileObj = profile as UTSJSONObject;
		const description = profileObj["description"] as string | null;
		return description != null && description != "" ? description : "";
	} catch (e) {
		// 如果转换失败，尝试使用 JSON 转换
		try {
			const profileStr = JSON.stringify(profile);
			const profileParsed = JSON.parse(profileStr);
			const profileObj2 = profileParsed as UTSJSONObject;
			const description = profileObj2["description"] as string | null;
			return description != null && description != "" ? description : "";
		} catch (e2) {
			// 如果还是失败，返回空字符串
			return "";
		}
	}
	// #endif
	
	// #ifndef APP-ANDROID
	// 在其他平台上，也使用安全的方式访问，避免类型转换错误
	try {
		// 尝试直接访问属性
		const profileAny = profile as any;
		const description = profileAny["description"];
		if (description != null && description != "" && description != undefined) {
			return description as string;
		}
	} catch (e) {
		// 如果失败，返回空字符串
	}
	return "";
	// #endif
}

function getProfileStudentRequiredIntegral(profile: any): number {
	// #ifdef APP-ANDROID
	// 在 Android 平台上，profile 可能是 UTSJSONObject，使用索引访问
	try {
		const profileObj = profile as UTSJSONObject;
		const integral = profileObj["student_required_integral"] as number | null;
		return integral != null ? integral : 500;
	} catch (e) {
		// 如果转换失败，尝试使用 JSON 转换
		try {
			const profileStr = JSON.stringify(profile);
			const profileParsed = JSON.parse(profileStr);
			const profileObj2 = profileParsed as UTSJSONObject;
			const integral = profileObj2["student_required_integral"] as number | null;
			return integral != null ? integral : 500;
		} catch (e2) {
			// 如果还是失败，返回默认值
			return 500;
		}
	}
	// #endif
	
	// #ifndef APP-ANDROID
	// 在其他平台上，也使用安全的方式访问，避免类型转换错误
	try {
		// 尝试直接访问属性
		const profileAny = profile as any;
		const integral = profileAny["student_required_integral"];
		if (integral != null && integral != undefined) {
			return integral as number;
		}
	} catch (e) {
		// 如果失败，返回默认值
	}
	return 500;
	// #endif
}

function getProfileMaxStudents(profile: any): number {
	// #ifdef APP-ANDROID
	// 在 Android 平台上，profile 可能是 UTSJSONObject，使用索引访问
	try {
		const profileObj = profile as UTSJSONObject;
		const maxStudents = profileObj["max_students"] as number | null;
		return maxStudents != null ? maxStudents : 10;
	} catch (e) {
		// 如果转换失败，尝试使用 JSON 转换
		try {
			const profileStr = JSON.stringify(profile);
			const profileParsed = JSON.parse(profileStr);
			const profileObj2 = profileParsed as UTSJSONObject;
			const maxStudents = profileObj2["max_students"] as number | null;
			return maxStudents != null ? maxStudents : 10;
		} catch (e2) {
			// 如果还是失败，返回默认值
			return 10;
		}
	}
	// #endif
	
	// #ifndef APP-ANDROID
	// 在其他平台上，也使用安全的方式访问，避免类型转换错误
	try {
		// 尝试直接访问属性
		const profileAny = profile as any;
		const maxStudents = profileAny["max_students"];
		if (maxStudents != null && maxStudents != undefined) {
			return maxStudents as number;
		}
	} catch (e) {
		// 如果失败，返回默认值
	}
	return 10;
	// #endif
}

// 方法
async function loadProfile() {
	try {
		loading.value = true;
		const profileData = await MentorService.getMentorProfile();
		
		// 在 Android 平台上，需要解析数据
		const profile = parse<MentorInfo>(profileData);
		if (profile == null) {
			ui.showToast({
				message: t("加载导师资料失败")
			});
			return;
		}
		
		// 填充表单数据（使用辅助函数安全访问属性）
		form.description = getProfileDescription(profile);
		form.student_required_integral = getProfileStudentRequiredIntegral(profile);
		form.max_students = getProfileMaxStudents(profile);
	} catch (error) {
		console.error('加载导师资料失败:', error);
		ui.showToast({
			message: t("加载导师资料失败")
		});
	} finally {
		loading.value = false;
	}
}

async function saveProfile() {
	if (disabled.value == true) {
		return;
	}

	try {
		loading.value = true;
		await MentorService.updateMentorProfile(form);
		
		ui.showToast({
			message: t("保存成功")
		});
		
		// 延迟返回上一页
		setTimeout(() => {
			router.back();
		}, 1500);
	} catch (error: any) {
		console.error('保存导师资料失败:', error);
		const errMsg = error.message as string | null | undefined;
		const errorMessage: string = (errMsg != null && errMsg != "" ? errMsg : t("保存失败")) as string;
		ui.showToast({
			message: errorMessage
		});
	} finally {
		loading.value = false;
	}
}

onMounted(() => {
	loadProfile();
});
</script>

<style lang="scss" scoped>
.container {
	height: 100%;
}
</style>
