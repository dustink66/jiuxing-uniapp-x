<template>
	<slot :disabled="isDisabled" :countdown="countdown" :btnText="btnText">
		<cl-button text :disabled="isDisabled" @tap="open">
			{{ btnText }}
		</cl-button>
	</slot>

	<cl-popup
		v-model="captcha.visible"
		ref="popupRef"
		direction="center"
		:title="t('获取短信验证码')"
		:size="500"
		v-if="config.enableSmsCaptcha"
	>
		<view class="p-3 pt-2 pb-4 w-full" v-if="captcha.visible">
			<cl-slide-verify
				:key="slideVerifyKey"
				ref="slideVerifyRef"
				v-model="captcha.passed"
				mode="image"
				image-url="/static/logo.png"
				:image-size="300"
				:angle-threshold="15"
				:text="t('向右滑动转动图片到正确位置')"
				@success="onSlideSuccess"
				@fail="onSlideFail"
			></cl-slide-verify>
		</view>
	</cl-popup>
</template>

<script lang="ts" setup>
import { computed, reactive, ref, type PropType } from "vue";
import { useUi } from "@/uni_modules/cool-ui";
import { $t, t } from "@/locale";
import { request, type Response } from "@/cool";
import { config } from "@/config";

const props = defineProps({
	phone: String,
	type: {
		type: String as PropType<'register' | 'login' | 'reset'>,
		default: 'login'
	}
});

const emit = defineEmits(["success"]);

const popupRef = ref(null);
const slideVerifyRef = ref(null);
const slideVerifyKey = ref(0); // 用于强制重新渲染组件

const ui = useUi();

type Captcha = {
	visible: boolean;
	loading: boolean;
	sending: boolean;
	passed: boolean;
};

// 验证码
const captcha = reactive<Captcha>({
	visible: false,
	loading: false,
	sending: false,
	passed: false
});

// 倒计时
const countdown = ref(0);

// 是否禁用
const isDisabled = computed(() => countdown.value > 0 || props.phone == "");

// 按钮文案
const btnText = computed(() =>
	countdown.value > 0 ? $t("{n}s后重新获取", { n: countdown.value }) : t("获取验证码")
);

// 清空
function clear() {}

// 关闭
function close() {
	captcha.visible = false;
	captcha.passed = false;
}

// 开始倒计时
function startCountdown() {
	countdown.value = 60;

	let timer: number = 0;

	function fn() {
		countdown.value--;

		if (countdown.value < 1) {
			clearInterval(timer);
		}
	}

	// @ts-ignore
	timer = setInterval(() => {
		fn();
	}, 1000);
	fn();
}

// 发送短信（先定义，供回调使用）
async function send() {
	// 如果启用了滑动验证，需要验证通过才能发送
	if (config.enableSmsCaptcha && captcha.passed != true) {
		return;
	}

	captcha.sending = true;

	await request({
		url: "/auth/send-code",
		method: "POST",
		data: {
			phone: props.phone,
			type: props.type
		}
	})
		.then(() => {
			ui.showToast({
				message: t("短信已发送，请查收")
			});
			startCountdown();
			close();
			emit("success");
		})
		.catch((err) => {
			const errMsg = (err as Response).message;
			const errorMessage = errMsg != null && errMsg != "" ? errMsg : t("发送失败");
			ui.showToast({
				message: errorMessage
			});
		})
		.finally(() => {
			captcha.sending = false;
		});
}

function onSlideSuccess() {
	send();
}

function onSlideFail() {
	ui.showToast({
		message: t("验证失败，请重试")
	});
	// 延迟重置，让用户看到失败提示
	setTimeout(() => {
		captcha.passed = false;
		slideVerifyKey.value++; // 强制重新渲染组件
	}, 1500);
}

// 打开
function open() {
	if (props.phone != "") {
		if (/^(?:(?:\+|00)86)?1[3-9]\d{9}$/.test(props.phone!)) {
			// 如果启用了滑动验证，显示验证弹窗
			if (config.enableSmsCaptcha) {
				captcha.visible = true;
				captcha.passed = false;
				slideVerifyKey.value++; // 强制重新渲染组件
			} else {
				// 如果未启用滑动验证，直接发送短信
				send();
			}
		} else {
			ui.showToast({
				message: t("请填写正确的手机号格式")
			});
		}
	}
}

defineExpose({
	open,
	send,
	startCountdown
});
</script>
